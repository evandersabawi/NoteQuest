94928ee2813fc9234bae0fac85e12435c.opus","dur":2.025,"voice":"af_heart","words":[[0.275,0.388],[0.388,0.887],[0.887,1.012],[1.012,1.125],[1.125,1.925]],"approx":false,"text":"The title and the author."},"682cd35048c700553a3f57f5eb4232d7e7037aaf08052542b28511f0ca03f411":{"file":"audio/682cd35048c700553a3f57f5eb4232d7e7037aaf08052542b28511f0ca03f411.opus","dur":1.775,"voice":"af_heart","words":[[0.25,0.388],[0.388,0.475],[0.475,0.725],[0.725,0.887],[0.887,1.675]],"approx":false,"text":"And it must be brief."},"0617d4bbc5ca08fa7d7ee9846b50906a763e264b96c09dc108aafec90c732fdd":{"file":"audio/0617d4bbc5ca08fa7d7ee9846b50906a763e264b96c09dc108aafec90c732fdd.opus","dur":3.55,"voice":"af_heart","words":[[0.275,0.55],[0.55,0.787],[0.787,0.988],[0.988,1.125],[1.125,1.825],[1.825,2.0],[2.0,2.212],[2.212,2.337],[2.337,2.5],[2.5,2.612],[2.612,2.712],[2.712,3.45]],"approx":false,"text":"Those three show up together, so lock them in as a set."},"a51630e70660c35f4db6b90a9c16e5db99fa5065856afdb0a4df45b3c7c841ab":{"file":"audio/a51630e70660c35f4db6b90a9c16e5db99fa5065856afdb0a4df45b3c7c841ab.opus","dur":3.9,"voice":"af_heart","words":[[0.3,0.525],[0.525,0.812],[0.812,0.925],[0.925,1.4],[1.4,1.975],[1.975,2.1],[2.1,2.288],[2.288,2.425],[2.425,2.575],[2.575,2.875],[2.875,3.8]],"approx":false,"text":"Then there's the exclude list, and this one is very quiz-able."},"55113dd6f0b0360a62067a3034697429ae040ecfb74e4911f824c8fc39e904fd":{"file":"audio/55113dd6f0b0360a62067a3034697429ae040ecfb74e4911f824c8fc39e904fd.opus","dur":3.75,"voice":"af_heart","words":[[0.3,0.55],[0.55,0.738],[0.738,1.225],[1.225,1.825],[1.825,2.538],[2.538,2.65],[2.65,3.65]],"approx":false,"text":"Leave out numbers, dates, statistics, and anecdotes."},"5d8a995a6fa7cf7c577cc9d49ca9e00d4aee4d0bcd5e2ad5caff27e2a8097276":{"file":"audio/5d8a995a6fa7cf7c577cc9d49ca9e00d4aee4d0bcd5e2ad5caff27e2a8097276.opus","dur":1.2,"voice":"af_heart","words":[[0.375,1.1]],"approx":false,"text":"Why?"},"0f0db3ccb36e29051218139ba2ff0b06aea8cd