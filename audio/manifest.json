{"version":1,"model":"hexgrad/Kokoro-82M","voice":"af_heart","bitrate":"32k","generated":"2026-09-06T14:13:47","sentences":{"f648372740c9688b8fd841d44df12589cbf3697c35b643e7f7a76a7741a99433":{"file":"audio/f648372740c9688b8fd841d44df12589cbf3697c35b643e7f7a76a7741a99433.opus","dur":3.325,"voice":"af_heart","words":[[0.275,0.575],[0.575,0.85],[0.85,1.0],[1.0,1.438],[1.438,1.812],[1.812,1.975],[1.975,3.225]],"approx":false,"text":"Every breath you take depends on photosynthesis."},"9e4e7dddd6b697e85a06af6a99d7a01bc15804c8a1274eacca0e79624db615c1":{"file":"audio/9e4e7dddd6b697e85a06af6a99d7a01bc15804c8a1274eacca0e79624db615c1.opus","dur":10.0,"voice":"af_heart","words":[[0.25,0.6],[0.6,1.038],[1.038,1.825],[1.825,1.988],[1.988,2.263],[2.263,2.337],[2.337,2.513],[2.513,2.65],[2.65,3.05],[3.05,3.263],[3.263,3.612],[3.612,4.088],[4.088,4.412],[4.412,4.713],[4.713,5.013],[5.013,5.15],[5.15,5.925],[5.925,6.037],[6.037,6.162],[6.162,6.65],[6.65,6.8],[6.8,7.438],[7.438,7.562],[7.562,7.713],[7.713,8.325],[8.325,8.412],[8.412,8.575],[8.575,8.925],[8.925,9.15],[9.15,9.9]],"approx":false,"text":"Plants capture sunlight and turn it into the sugar that feeds almost every food chain on Earth, and the oxygen they release is the oxygen in your lungs right now."},"0a24cb606d90eb1eb6908e91f77f5451e8fac2fcbf7089be96e721877ef7ce57":{"file":"audio/0a24cb606d90eb1eb6908e91f77f5451e8fac2fcbf7089be96e721877ef7ce57.opus","dur":2.6,"voice":"af_heart","words":[[0.3,0.475],[0.475,0.613],[0.613,0.725],[0.725,1.012],[1.012,1.2],[1.2,1.337],[1.337,1.425],[1.425,1.6],[1.6,2.5]],"approx":false,"text":"So let us start with where it all happens."},"ea42c4c84c9c401a879ff82b44d9f65cb1960a2b053be5d9d09553d2f7764576":{"file":"audio/ea42c4c84c9c401a879ff82b44d9f65cb1960a2b053be5d9d09553d2f7764576.opus","dur":3.325,"voice":"af_heart","words":[[0.275,0.95],[0.95,1.25],[1.25,1.6],[1.6,2.05],[2.05,3.225]],"approx":false,"text":"Photosynthesis takes place inside chloroplasts."},"99a0ab2c82b93d859537b845e0984e781f76c2b6acc605b8808b7bb307e0d726":{"file":"audio/99a0ab2c82b93d859537b845e0984e781f76c2b6acc605b8808b7bb307e0d726.opus","dur":6.85,"voice":"af_heart","words":[[0.325,0.875],[0.875,1.1],[1.1,1.8],[1.8,1.938],[1.938,2.337],[2.337,2.462],[2.462,2.75],[2.75,3.125],[3.125,3.413],[3.413,4.55],[4.55,4.662],[4.662,4.725],[4.725,5.013],[5.013,5.125],[5.125,5.35],[5.35,5.5],[5.5,5.763],[5.763,5.825],[5.825,6.75]],"approx":false,"text":"Inside each chloroplast are stacks of flat discs called thylakoids, and a stack of them is called a granum."},"af2a9b052b3d34b30e3f65868df23b0cb89ff4484b664244f18924b6c283da09":{"file":"audio/af2a9b052b3d34b30e3f65868df23b0cb89ff4484b664244f18924b6c283da09.opus","dur":3.15,"voice":"af_heart","words":[[0.25,0.362],[0.362,0.688],[0.688,0.825],[0.825,1.238],[1.238,1.325],[1.325,1.887],[1.887,2.038],[2.038,2.125],[2.125,3.05]],"approx":false,"text":"The fluid that surrounds the stacks is the stroma."},"99d427a3a1fe1ad8ea3fe84a9963e7bb117bd8076ef9b006d36fdfe3c7e5898c":{"file":"audio/99d427a3a1fe1ad8ea3fe84a9963e7bb117bd8076ef9b006d36fdfe3c7e5898c.opus","dur":3.475,"voice":"af_heart","words":[[0.275,0.613],[0.613,0.725],[0.725,1.275],[1.275,1.475],[1.475,1.688],[1.688,1.788],[1.788,1.863],[1.863,2.25],[2.25,2.65],[2.65,3.375]],"approx":false,"text":"Pause and think: which part do you expect handles light?"},"cb3763687c437be470a97c709187c29161e954449d32b60126ac97b53314ef4f":{"file":"audio/cb3763687c437be470a97c709187c29161e954449d32b60126ac97b53314ef4f.opus","dur":5.325,"voice":"af_heart","words":[[0.25,0.362],[0.362,1.025],[1.025,1.575],[1.575,2.175],[2.175,2.5],[2.5,2.7],[2.7,2.825],[2.825,2.962],[2.962,3.062],[3.062,3.425],[3.425,3.9],[3.9,4.438],[4.438,5.225]],"approx":false,"text":"The thylakoid membranes do, because that is where the green pigment chlorophyll sits."},"2fb2b7ae095433ce3f351a126c5cfe4d6cf009f63100961815cc856d0b2ebff9":{"file":"audio/2fb2b7ae095433ce3f351a126c5cfe4d6cf009f63100961815cc856d0b2ebff9.opus","dur":3.45,"voice":"af_heart","words":[[0.25,0.362],[0.362,0.637],[0.637,1.275],[1.275,1.45],[1.45,1.587],[1.587,1.85],[1.85,2.288],[2.288,3.35]],"approx":false,"text":"The first stage is the light dependent reactions."},"5b26cb1c3e3e3d30ce75e1285cabf533915253ddbb2d22b2459f328b50c34bc5":{"file":"audio/5b26cb1c3e3e3d30ce75e1285cabf533915253ddbb2d22b2459f328b50c34bc5.opus","dur":7.05,"voice":"af_heart","words":[[0.275,0.362],[0.362,0.463],[0.463,1.05],[1.05,2.013],[2.013,2.575],[2.575,3.15],[3.15,3.5],[3.5,3.625],[3.625,3.85],[3.85,4.5],[4.5,4.65],[4.65,5.025],[5.025,5.225],[5.225,5.675],[5.675,5.8],[5.8,6.1],[6.1,6.95]],"approx":false,"text":"In the thylakoid membranes, chlorophyll absorbs red and blue light and uses that energy to split water."},"269d0632a184cf8c2122962c65ac5e52f25e95a043a18a58a05aa2a56d424810":{"file":"audio/269d0632a184cf8c2122962c65ac5e52f25e95a043a18a58a05aa2a56d424810.opus","dur":7.025,"voice":"af_heart","words":[[0.275,0.675],[0.675,1.05],[1.05,1.538],[1.538,2.312],[2.312,2.45],[2.45,2.962],[2.962,3.2],[3.2,3.525],[3.525,4.513],[4.513,5.388],[5.388,5.55],[5.55,6.925]],"approx":false,"text":"Splitting water releases oxygen and produces two energy carriers, ATP and NADPH."},"fce6565153d51641daea42e8263eae7d0cfa2e44f91c7fc8db0e26cdf6aa1f88":{"file":"audio/fce6565153d51641daea42e8263eae7d0cfa2e44f91c7fc8db0e26cdf6aa1f88.opus","dur":4.275,"voice":"af_heart","words":[[0.25,0.362],[0.362,0.725],[0.725,1.15],[1.15,1.288],[1.288,1.375],[1.375,1.775],[1.775,2.525],[2.525,2.763],[2.763,3.138],[3.138,3.212],[3.212,3.3],[3.3,4.175]],"approx":false,"text":"The second stage is the Calvin cycle, which runs in the stroma."},"b93335390ffb756d65237fb440e0faea6921dab6335aa480ba8d6d00235fc004":{"file":"audio/b93335390ffb756d65237fb440e0faea6921dab6335aa480ba8d6d00235fc004.opus","dur":7.0,"voice":"af_heart","words":[[0.275,0.438],[0.438,0.562],[0.562,1.125],[1.125,1.438],[1.438,2.237],[2.237,2.65],[2.65,3.025],[3.025,4.1],[4.1,4.237],[4.237,4.75],[4.75,4.875],[4.875,4.963],[4.963,5.025],[5.025,5.525],[5.525,5.838],[5.838,6.9]],"approx":false,"text":"Here an enzyme called RuBisCO grabs carbon dioxide and attaches it to a molecule called RuBP."},"5a6f366f5ff023cded74d2901acfbe98893c4c765be96be17c9e39667aef4194":{"file":"audio/5a6f366f5ff023cded74d2901acfbe98893c4c765be96be17c9e39667aef4194.opus","dur":5.575,"voice":"af_heart","words":[[0.3,0.588],[0.588,0.713],[0.713,1.538],[1.538,1.675],[1.675,2.5],[2.5,2.675],[2.675,3.025],[3.025,3.625],[3.625,3.763],[3.763,4.15],[4.15,4.475],[4.475,5.475]],"approx":false,"text":"Using the ATP and NADPH from stage one, the cycle builds glucose."},"6409d59d2fddc366ff2d74774e83d18afe67ae51f7529af2f335b39714258752":{"file":"audio/6409d59d2fddc366ff2d74774e83d18afe67ae51f7529af2f335b39714258752.opus","dur":7.375,"voice":"af_heart","words":[[0.3,0.537],[0.537,0.875],[0.875,1.0],[1.0,1.275],[1.275,2.0],[2.0,2.8],[2.8,3.075],[3.075,4.088],[4.088,4.5],[4.5,5.15],[5.15,6.2],[6.2,6.325],[6.325,7.275]],"approx":false,"text":"Three things can hold photosynthesis back: light intensity, carbon dioxide concentration, and temperature."},"034f46191e7e4458884ea20569cb6e889e2f4efc6fded12c971bcf8c5f935d55":{"file":"audio/034f46191e7e4458884ea20569cb6e889e2f4efc6fded12c971bcf8c5f935d55.opus","dur":5.575,"voice":"af_heart","words":[[0.25,0.675],[0.675,0.9],[0.9,1.05],[1.05,1.225],[1.225,1.65],[1.65,2.212],[2.212,2.513],[2.513,2.6],[2.6,3.35],[3.35,3.475],[3.475,3.675],[3.675,3.825],[3.825,4.088],[4.088,4.175],[4.175,4.6],[4.6,5.475]],"approx":false,"text":"Whichever one is in shortest supply sets the pace, and that is called the limiting factor."},"94169cac171dbabdf57219b7340c7ea891c9b03541ed27f5a740ebbfda615848":{"file":"audio/94169cac171dbabdf57219b7340c7ea891c9b03541ed27f5a740ebbfda615848.opus","dur":1.8,"voice":"af_heart","words":[[0.3,0.512],[0.512,0.613],[0.613,0.675],[0.675,0.938],[0.938,1.7]],"approx":false,"text":"Here is a quick check."},"d2a57ad0f41396100ebbe7fd9f6561d1f30be81244ca7cae12d722157b3816de":{"file":"audio/d2a57ad0f41396100ebbe7fd9f6561d1f30be81244ca7cae12d722157b3816de.opus","dur":3.8,"voice":"af_heart","words":[[0.275,0.35],[0.35,0.65],[0.65,0.85],[0.85,1.163],[1.163,1.275],[1.275,1.562],[1.562,1.675],[1.675,2.3],[2.3,2.438],[2.438,2.513],[2.513,2.6],[2.6,2.888],[2.888,3.7]],"approx":false,"text":"A plant has plenty of light and water, but it is still slow."},"f3087e7a63400ea500b081daa760b82575c7c46ee9649380eff1a98f6b8bf567":{"file":"audio/f3087e7a63400ea500b081daa760b82575c7c46ee9649380eff1a98f6b8bf567.opus","dur":1.925,"voice":"af_heart","words":[[0.275,0.388],[0.388,0.525],[0.525,1.0],[1.0,1.825]],"approx":false,"text":"What is probably missing?"},"3523cb6ec98473cc25d4eb9326f8b73e1b5e11044a6acce426450c1c332671f4":{"file":"audio/3523cb6ec98473cc25d4eb9326f8b73e1b5e11044a6acce426450c1c332671f4.opus","dur":4.675,"voice":"af_heart","words":[[0.275,0.625],[0.625,1.7],[1.7,2.038],[2.038,2.337],[2.337,2.45],[2.45,2.825],[2.825,2.975],[2.975,3.35],[3.35,3.7],[3.7,3.962],[3.962,4.575]],"approx":false,"text":"Carbon dioxide, because light and water are already taken care of."},"ee641745b57e6dfbf7fc553c7ac37ca10f529b5266a5c2b15807d62b25820a39":{"file":"audio/ee641745b57e6dfbf7fc553c7ac37ca10f529b5266a5c2b15807d62b25820a39.opus","dur":2.95,"voice":"af_heart","words":[[0.275,1.025],[1.025,1.525],[1.525,1.675],[1.675,2.85]],"approx":false,"text":"Photosynthesis happens in chloroplasts."},"1bb1cbedefca0108033f836ece0a8740530fcd9abbe35c8b7113468e6114ddba":{"file":"audio/1bb1cbedefca0108033f836ece0a8740530fcd9abbe35c8b7113468e6114ddba.opus","dur":5.375,"voice":"af_heart","words":[[0.3,0.487],[0.487,1.012],[1.012,1.087],[1.087,1.175],[1.175,1.837],[1.837,2.087],[2.087,3.163],[3.163,4.175],[4.175,4.3],[4.3,5.275]],"approx":false,"text":"Light reactions in the thylakoids make ATP, NADPH and oxygen."},"c91a75f584c8ee651d6615992950fc75f182bcc8192639fd9e2cd391e34bddec":{"file":"audio/c91a75f584c8ee651d6615992950fc75f182bcc8192639fd9e2cd391e34bddec.opus","dur":5.65,"voice":"af_heart","words":[[0.25,0.35],[0.35,0.787],[0.787,1.2],[1.2,1.288],[1.288,1.375],[1.375,2.175],[2.175,2.6],[2.6,2.925],[2.925,3.05],[3.05,3.35],[3.35,3.725],[3.725,4.362],[4.362,4.55],[4.55,5.55]],"approx":false,"text":"The Calvin cycle in the stroma uses those to turn carbon dioxide into glucose."},"8ef8ae7fe2c99e844c1c51f768656d423b446abfc376719351d9bf809be3b35e":{"file":"audio/8ef8ae7fe2c99e844c1c51f768656d423b446abfc376719351d9bf809be3b35e.opus","dur":7.825,"voice":"af_heart","words":[[0.325,0.675],[0.675,0.887],[0.887,1.3],[1.3,1.613],[1.613,2.2],[2.2,2.712],[2.712,3.05],[3.05,3.825],[3.825,3.938],[3.938,4.025],[4.025,4.45],[4.45,5.037],[5.037,5.2],[5.2,5.625],[5.625,6.175],[6.175,6.6],[6.6,6.925],[6.925,7.725]],"approx":false,"text":"Leaves look green because chlorophyll reflects green light, and the limiting factor is whichever ingredient runs short first."},"50c64711351ad8804cfc3394a8e191cb806f28a926408936f3e0f3ee008cfd2e":{"file":"audio/50c64711351ad8804cfc3394a8e191cb806f28a926408936f3e0f3ee008cfd2e.opus","dur":2.725,"voice":"af_heart","words":[[0.3,0.6],[0.6,0.912],[0.912,1.175],[1.175,1.325],[1.325,1.575],[1.575,1.788],[1.788,2.625]],"approx":false,"text":"Every living thing is built from cells."},"38d567fef5001a980befc5b84059bc61741835e93a49684a73185ade7dbcac54":{"file":"audio/38d567fef5001a980befc5b84059bc61741835e93a49684a73185ade7dbcac54.opus","dur":5.25,"voice":"af_heart","words":[[0.25,0.35],[0.35,0.9],[0.9,1.188],[1.188,1.262],[1.262,2.35],[2.35,2.462],[2.462,2.55],[2.55,3.075],[3.075,3.612],[3.612,3.75],[3.75,4.088],[4.088,4.325],[4.325,4.45],[4.45,5.15]],"approx":false,"text":"The nucleus holds the instructions, and the membrane decides what comes in and out."},"de7cdcededf0771896c131c49c42740d4db511bd40fb922ff65e8505135f260e":{"file":"audio/de7cdcededf0771896c131c49c42740d4db511bd40fb922ff65e8505135f260e.opus","dur":3.65,"voice":"af_heart","words":[[0.3,1.238],[1.238,1.538],[1.538,1.925],[1.925,2.188],[2.188,2.65],[2.65,3.55]],"approx":false,"text":"Mitochondria turn sugar into usable energy."},"0b5d76de4b1e1878d7ac4e9b38563f3bb4f7b7b2805ad3d61a1f0a9a104a4bfa":{"file":"audio/0b5d76de4b1e1878d7ac4e9b38563f3bb4f7b7b2805ad3d61a1f0a9a104a4bfa.opus","dur":3.175,"voice":"af_heart","words":[[0.275,0.475],[0.475,0.625],[0.625,0.85],[0.85,1.2],[1.2,1.675],[1.675,1.887],[1.887,2.1],[2.1,2.337],[2.337,2.438],[2.438,3.075]],"approx":false,"text":"That is why muscle cells have so many of them."},"28725bd3e29655508f3a3d31318f7b089c664c40fa586cd092027969285de10a":{"file":"audio/28725bd3e29655508f3a3d31318f7b089c664c40fa586cd092027969285de10a.opus","dur":13.25,"voice":"af_heart","words":[[0.275,0.55],[0.55,0.662],[0.662,0.9],[0.9,1.238],[1.238,2.413],[2.413,2.513],[2.513,2.65],[2.65,3.125],[3.125,3.275],[3.275,3.725],[3.725,4.062],[4.062,4.5],[4.5,4.888],[4.888,5.325],[5.325,5.463],[5.463,5.625],[5.625,5.875],[5.875,6.875],[6.875,7.213],[7.213,7.662],[7.662,7.987],[7.987,8.512],[8.512,8.85],[8.85,9.0],[9.0,9.1],[9.1,9.35],[9.35,9.65],[9.65,10.162],[10.162,10.312],[10.312,10.562],[10.562,10.65],[10.65,10.975],[10.975,11.062],[11.062,11.175],[11.175,11.887],[11.887,12.287],[12.287,13.15]],"approx":false,"text":"Here's the thing about summarizing: it is probably the single most useful writing skill you will ever practice, because almost every subject asks you to take something long and hand it back in a smaller, clearer form."},"b64eb933dd9d0ec32e5be09f9fbdf48c5e5d054c601acd93677b0ea78e0e6c90":{"file":"audio/b64eb933dd9d0ec32e5be09f9fbdf48c5e5d054c601acd93677b0ea78e0e6c90.opus","dur":7.6,"voice":"af_heart","words":[[0.275,0.537],[0.537,0.688],[0.688,0.787],[0.787,1.5],[1.5,1.663],[1.663,2.35],[2.35,2.475],[2.475,2.562],[2.562,2.962],[2.962,3.038],[3.038,3.1],[3.1,3.85],[3.85,4.1],[4.1,4.325],[4.325,4.45],[4.45,4.85],[4.85,5.0],[5.0,5.237],[5.237,5.675],[5.675,5.8],[5.8,6.0],[6.0,6.45],[6.45,6.925],[6.925,7.5]],"approx":false,"text":"Whether it's a movie, an article, or a chapter of a book, being able to retell it well proves that you actually understood it."},"ec7c12a83471c71dfe1652a2cd73c5de4be2ebb00c6ed5ee564ce23836732375":{"file":"audio/ec7c12a83471c71dfe1652a2cd73c5de4be2ebb00c6ed5ee564ce23836732375.opus","dur":6.45,"voice":"af_heart","words":[[0.275,0.4],[0.4,0.988],[0.988,1.375],[1.375,1.675],[1.675,1.788],[1.788,1.85],[1.85,2.075],[2.075,2.913],[2.913,3.212],[3.212,3.337],[3.337,3.4],[3.4,4.075],[4.075,4.412],[4.412,5.075],[5.075,5.4],[5.4,5.55],[5.55,6.35]],"approx":false,"text":"Your notes, titled Tips for a Good Summary, start with a definition worth memorizing word for word."},"4dd77313dbabd234fd299e8659925d52e06aaaf7d9455c2b0150b2b146f6e804":{"file":"audio/4dd77313dbabd234fd299e8659925d52e06aaaf7d9455c2b0150b2b146f6e804.opus","dur":4.475,"voice":"af_heart","words":[[0.275,0.362],[0.362,0.938],[0.938,1.062],[1.062,1.163],[1.163,1.575],[1.575,1.7],[1.7,2.15],[2.15,2.888],[2.888,2.987],[2.987,3.087],[3.087,3.5],[3.5,3.65],[3.65,4.375]],"approx":false,"text":"A summary is a clear and concise retelling of a text or work."},"b67e24c15c0d8227965feaf8bf557655002e2a154f548ba2ab33ad51a085e6c1":{"file":"audio/b67e24c15c0d8227965feaf8bf557655002e2a154f548ba2ab33ad51a085e6c1.opus","dur":8.7,"voice":"af_heart","words":[[0.275,0.525],[0.525,0.7],[0.7,1.438],[1.438,1.825],[1.825,1.95],[1.95,2.925],[2.925,3.013],[3.013,3.1],[3.1,3.55],[3.55,3.737],[3.737,4.125],[4.125,4.412],[4.412,4.525],[4.525,5.4],[5.4,5.513],[5.513,5.625],[5.625,5.838],[5.838,5.963],[5.963,6.287],[6.287,6.625],[6.625,6.925],[6.925,7.2],[7.2,7.325],[7.325,7.562],[7.562,7.825],[7.825,8.6]],"approx":false,"text":"Those two qualities, clear and concise, are the balance you're always trying to strike, and they're going to shape every other rule we talk about today."},"78a95bc516b64beb01dfea6ee6a913c69ebed6e2247353bed8267ee8651a82fb":{"file":"audio/78a95bc516b64beb01dfea6ee6a913c69ebed6e2247353bed8267ee8651a82fb.opus","dur":5.775,"voice":"af_heart","words":[[0.275,0.5],[0.5,0.825],[0.825,1.137],[1.137,1.238],[1.238,1.45],[1.45,2.425],[2.425,2.688],[2.688,2.788],[2.788,3.075],[3.075,3.55],[3.55,3.675],[3.675,3.9],[3.9,4.037],[4.037,4.325],[4.325,4.475],[4.475,4.638],[4.638,4.725],[4.725,5.675]],"approx":false,"text":"Let's slow down on that definition, because a quiz question is going to ask you for it directly."},"2455861e280c00e6c4deba215cae040bf9bdfffcaf784d39367b9b935ea403c5":{"file":"audio/2455861e280c00e6c4deba215cae040bf9bdfffcaf784d39367b9b935ea403c5.opus","dur":4.65,"voice":"af_heart","words":[[0.275,0.362],[0.362,0.825],[0.825,0.975],[0.975,1.188],[1.188,1.25],[1.25,1.975],[1.975,2.138],[2.138,2.2],[2.2,2.925],[2.925,3.038],[3.038,3.188],[3.188,3.263],[3.263,3.5],[3.5,4.55]],"approx":false,"text":"A summary is not a review, not a reaction, and not a full description."},"56aa8444cb7a5cafda1a5278d31540873fded8ab49bf2c18df03715af679aa1b":{"file":"audio/56aa8444cb7a5cafda1a5278d31540873fded8ab49bf2c18df03715af679aa1b.opus","dur":9.325,"voice":"af_heart","words":[[0.25,0.4],[0.4,0.525],[0.525,0.6],[0.6,1.575],[1.575,1.688],[1.688,1.775],[1.775,2.025],[2.025,2.112],[2.112,2.263],[2.263,2.587],[2.587,3.312],[3.312,3.625],[3.625,3.725],[3.725,4.1],[4.1,4.225],[4.225,4.537],[4.537,4.838],[4.838,4.975],[4.975,5.425],[5.425,5.612],[5.612,5.975],[5.975,6.45],[6.45,6.575],[6.575,7.438],[7.438,7.75],[7.75,7.875],[7.875,8.1],[8.1,8.438],[8.438,8.525],[8.525,9.225]],"approx":false,"text":"It is a retelling, and it has to be both clear, meaning a reader who hasn't seen the original can follow it, and concise, meaning you're not padding it out."},"3eeeb3e15db9dd48afa512e4f25fd95e1b828abc0049d122dfe8dec145eab557":{"file":"audio/3eeeb3e15db9dd48afa512e4f25fd95e1b828abc0049d122dfe8dec145eab557.opus","dur":2.825,"voice":"af_heart","words":[[0.275,0.388],[0.388,0.675],[0.675,0.938],[0.938,1.175],[1.175,1.413],[1.413,1.5],[1.5,1.712],[1.712,2.725]],"approx":false,"text":"Your notes list three things you can summarize."},"37a62f51b250d9802040f32a05d7d79e6358be90c403b0d38dd908163b80b502":{"file":"audio/37a62f51b250d9802040f32a0