"words":[[0.25,0.362],[0.362,0.637],[0.637,1.275],[1.275,1.45],[1.45,1.587],[1.587,1.85],[1.85,2.288],[2.288,3.35]],"approx":false,"text":"The first stage is the light dependent reactions."},"5b26cb1c3e3e3d30ce75e1285cabf533915253ddbb2d22b2459f328b50c34bc5":{"file":"audio/5b26cb1c3e3e3d30ce75e1285cabf533915253ddbb2d22b2459f328b50c34bc5.opus","dur":7.05,"voice":"af_heart","words":[[0.275,0.362],[0.362,0.463],[0.463,1.05],[1.05,2.013],[2.013,2.575],[2.575,3.15],[3.15,3.5],[3.5,3.625],[3.625,3.85],[3.85,4.5],[4.5,4.65],[4.65,5.025],[5.025,5.225],[5.225,5.675],[5.675,5.8],[5.8,6.1],[6.1,6.95]],"approx":false,"text":"In the thylakoid membranes, chlorophyll absorbs red and blue light and uses that energy to split water."},"269d0632a184cf8c2122962c65ac5e52f25e95a043a18a58a05aa2a56d424810":{"file":"audio/269d0632a184cf8c2122962c65ac5e52f25e95a043a18a58a05aa2a56d424810.opus","dur":7.025,"voice":"af_heart","words":[[0.275,0.675],[0.675,1.05],[1.05,1.538],[1.538,2.312],[2.312,2.45],[2.45,2.962],[2.962,3.2],[3.2,3.525],[3.525,4.513],[4.513,5.388],[5.388,5.55],[5.55,6.925]],"approx":false,"text":"Splitting water releases oxygen and produces two energy carriers, ATP and NADPH."},"fce6565153d51641daea42e8263eae7d0cfa2e44f91c7fc8db0e26cdf6aa1f88":{"file":"audio/fce6565153d51641daea42e8263eae7d0cfa2e44f91c7fc8db0e26cdf6aa1f88.opus","dur":4.275,"voice":"af_heart","words":[[0.25,0.362],[0.362,0.725],[0.725,1.15],[1.15,1.288],[1.288,1.375],[1.375,1.775],[1.775,2.525],[2.525,2.763],[2.763,3.138],[3.138,3.212],[3.212,3.3],[3.3,4.175]],"approx":false,"text":"The second stage is the Calvin cycle, which runs in the stroma."},"b93335390ffb756d65237fb440e0faea6921dab6335aa480ba8d6d00235fc004":{"file":"audio/b93335390ffb756d65237fb440e0faea6921dab6335aa480ba8d6d00235fc004.opus","dur":7.0,"voice":"af_heart","words":[[0.275,0.438],[0.438,0.562],[0.562,1.125],[1.125,1.438],[1.438,2.237],[2.237,2.65],[2.65,3.025],[3.025,4.1],[4.1,4.237],[4.237,4.75],[4.75,4.875],[4.875,4.963],[4.963,5.025],[5.025,5.525],[5.525,5.838],[5.838,6.9]],"approx":false,"text":"Here an enzyme called RuBisCO grabs carbon dioxide and attaches it to a molecule called RuBP."},"5a6f366f5ff023cded74d2901acfbe98893c4c765be96be17c9e39667aef4194":{"file":"audio/5a6f366f5ff023cded74d2901acfbe98893c4c765be96be17c9e39667aef4194.opus","dur":5.575,"voice":"af_heart","words":[[0.3,0.588],[0.588,0.713],[0.713,1.538],[1.538,1.675],[1.675,2.5],[2.5,2.675],[2.675,3.025],[3.025,3.625],[3.625,3.763],[3.763,4.15],[4.15,4.475],[4.475,5.475]],"approx":false,"text":"Using the ATP and NADPH from stage one, the cycle builds glucose."},"6409d59d2fddc366ff2d74774e83d18afe67ae51f7529af2f335b39714258752":{"file":"audio/6409d59d2fddc366ff2d74774e83d18afe67ae51f7529af2f335b39714258752.opus","dur":7.375,"voice":"af_heart","words":[[0.3,0.537],[0.537,0.875],[0.875,1.0],[1.0,1.275],[1.275,2.0],[2.0,2.8],[2.8,3.075],[3.075,4.088],[4.088,4.5],[4.5,5.15],[5.15,6.2],[6.2,6.325],[6.325,7.275]],"approx":false,"text":"Three things can hold photosynthesis back: light intensity, carbon dioxide concentration, and temperature."},"034f46191e7e4458884ea20569cb6e889e2f4efc6fded12c971bcf8c5f935d55":{"file":"audio/034f46191e7e4458884ea20569cb6e889e2f4efc6fded12c971bcf8c5f935d55.opus","dur":5.575,"voice":"af_heart","words":[[0.25,0.675],[0.675,0.9],[0.9,1.05],[1.05,1.225],[1.225,1.65],[1.65,2.212],[2.212,2.513],[2.513,2.6],[2.6,3.35],[3.35,3.475],[3.475,3.675],[3.675,3.825],[3.825,4.088],[4.088,4.175],[4.175,4.6],[4.6,5.475]],"approx":false,"text":"Whichever one is in shortest supply sets the pace, and that is called the limiting factor."},"94169cac171dbabdf57219b7340c7ea891c9b03541ed27f5a740ebbfda615848":{"file":"audio/94169cac171dbabdf57219b7340c7ea891c9b03541ed27f5a740ebbfda615848.opus","dur":1.8,"voice":"af_heart","words":[[0.3,0.512],[0.512,0.613],[0.613,0.675],[0.675,0.938],[0.938,1.7]],"approx":false,"text":"Here is a quick check."},"d2a57ad0f41396100ebbe7fd9f6561d1f30be81244ca7cae12d722157b3816de":{"file":"audio/d2a57ad0f413961