# Copy to functions/.env and fill in. These are not secrets (secrets go in with `firebase functions:secrets:set`).
# Stripe price ids for the two plans (Stripe dashboard -> Product catalog -> the plan -> Pricing -> price id).
STRIPE_PRICE_STUDY=price_xxx
STRIPE_PRICE_PLUS=price_xxx
# Sites Stripe may send people back to after paying, comma separated.
ALLOWED_ORIGINS=https://evandersabawi.github.io,http://localhost:8765
