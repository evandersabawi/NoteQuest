rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own profile and study sets.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /creations/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Username -> account lookup, needed so people can log in by username (readable before login).
    match /usernames/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Security-question recovery: the account password sealed with a key derived from the answer.
    match /recovery/{name} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
