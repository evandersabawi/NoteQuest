rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own profile and study sets.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /creations/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
